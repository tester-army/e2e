{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/testbed/e2e.config.ts",
    "packages/testbed/e2e.*.config.ts",
    "packages/testbed/tests*/**/*.ts",
    "packages/testbed/dogfood/server.mjs",
    "packages/testbed/bench/app/**/*.{ts,tsx}",
    "packages/web-benchmark/e2e.config.ts",
    "packages/web-benchmark/e2e.*.config.ts",
    "packages/web-benchmark/tests*/**/*.ts",
    "packages/web-benchmark/app/src/app/**/*.{ts,tsx}",
    "packages/e2e/tests/types/sdk-types.ts"
  ],
  "ignorePatterns": [
    "docs/**",
    "**/next-env.d.ts",
    "**/.e2e/**",
    "packages/e2e/tests/tmp-projects/**"
  ],
  "ignoreDependencies": [
    "@e2edev/e2e",
    "@e2edev/playwright"
  ],
  "rules": {
    "unused-class-member": "warn",
    "dev-dependencies-in-production": "warn"
  },
  "ignoreUnresolvedImports": [
    "**/dist/**"
  ]
}
