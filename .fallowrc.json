{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/testbed/e2e.config.ts",
    "apps/testbed/e2e.*.config.ts",
    "apps/testbed/tests*/**/*.ts",
    "apps/testbed/dogfood/server.mjs",
    "apps/testbed/app/bug-garden.mjs",
    "apps/web-benchmark/e2e.config.ts",
    "apps/web-benchmark/e2e.*.config.ts",
    "apps/web-benchmark/tests*/**/*.ts",
    "apps/web-benchmark/app/src/app/**/*.{ts,tsx}",
    "apps/mobile-benchmark/e2e.config.ts",
    "apps/mobile-benchmark/e2e.*.config.ts",
    "apps/mobile-benchmark/tests*/**/*.ts",
    "apps/mobile-benchmark/index.ts",
    "packages/e2e/tests/types/sdk-types.ts",
    "packages/web/tests/types/connection.ts",
    "packages/web/tests/types/init-scripts.ts",
    "packages/web/tests/types/keyboard.ts",
    "packages/web/tests/types/media.ts",
    "packages/web/tests/types/routes.ts",
    "packages/mobile/tests/types/options.ts",
    "packages/decision/tests/types/options.ts",
    "packages/e2e/tests/live/*.ts",
    "packages/e2e/src/config/register.ts",
    "apps/test-authoring/cli.ts",
    "apps/test-authoring/connected-cli.ts",
    "apps/test-authoring/connected/public/app.js",
    "apps/test-authoring/connected/public/expense-app.js",
    "apps/test-authoring/connected/public/server.mjs",
    "apps/test-authoring/connected/public/style.css",
    "apps/test-authoring/connected/public/lower/*.test.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    "examples/**",
    "**/next-env.d.ts",
    "**/.e2e/**",
    "packages/e2e/tests/tmp-projects/**"
  ],
  "ignoreDependencies": [
    "e2e",
    "@e2e-dev/web",
    "@openrouter/ai-sdk-provider",
    "@expo/fingerprint",
    "@expo/repack-app",
    "@oxc-project/runtime",
    "@agent-device/testmu"
  ],
  "rules": {
    "unused-class-member": "warn",
    "dev-dependencies-in-production": "warn"
  },
  "ignoreUnresolvedImports": [
    "**/dist/**"
  ]
}
