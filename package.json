{
  "name": "e2e-monorepo",
  "private": true,
  "description": "Open standard for agentic end-to-end testing",
  "keywords": [
    "e2e",
    "testing",
    "agentic"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --filter e2e build",
    "check": "pnpm run check:spec && pnpm run typecheck",
    "check:spec": "tsc --project tsconfig.spec.json",
    "typecheck": "pnpm --filter e2e typecheck",
    "test": "pnpm --filter e2e test",
    "test:testbed": "pnpm --filter e2e build && pnpm --filter @e2e/testbed test",
    "test:public": "pnpm --filter e2e build && pnpm --filter @e2e/testbed test:public"
  },
  "contributors": [
    "Oskar Kwa\u015bniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@10.2.1"
}
