{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2e.dev/schema/agent-locate-v1.schema.json",
  "title": "e2e agent-locate-1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "target", "explanation"],
  "properties": {
    "protocolVersion": { "const": "agent-locate-1" },
    "target": {
      "anyOf": [
        { "$ref": "#/$defs/nodeTarget" },
        { "$ref": "#/$defs/pointTarget" },
        { "type": "null" }
      ]
    },
    "explanation": { "type": "string", "maxLength": 8192 }
  },
  "$defs": {
    "nodeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "pointTarget": {
      "description": "Offered only to vision calls; the runner validates and hit-tests the point before any dispatch.",
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "revision"],
      "properties": {
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 100000 },
            "y": { "type": "number", "minimum": 0, "maximum": 100000 }
          }
        },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
