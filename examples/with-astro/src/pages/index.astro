---
import '@fontsource/inter/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>e2e - with-astro</title>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <img src="/e2e-logotype-white.svg" alt="e2e" width="69" height="24" />
      </header>

      <main class="hero">
        <p class="eyebrow">[ with-astro ]</p>
        <h1 class="title">say hello</h1>
        <p class="lede">A demo screen for the e2e examples. Type a name and the app greets you.</p>

        <form class="form" id="greeting">
          <div class="field">
            <input id="name" class="field-input" autocomplete="off" aria-invalid="false" />
            <label class="field-label" for="name">name</label>
          </div>
          <button class="button" type="submit">greet</button>
          <p class="error" role="alert" id="error" hidden>enter a name first.</p>
          <p class="status" role="status" id="status" hidden></p>
        </form>
      </main>

      <footer class="footer">example app for e2e. the tests live in tests/.</footer>
    </div>

    <script>
      const form = document.querySelector<HTMLFormElement>('#greeting')!;
      const input = document.querySelector<HTMLInputElement>('#name')!;
      const error = document.querySelector<HTMLParagraphElement>('#error')!;
      const status = document.querySelector<HTMLParagraphElement>('#status')!;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const value = input.value.trim();
        if (value === '') {
          error.hidden = false;
          input.setAttribute('aria-invalid', 'true');
          status.hidden = true;
          return;
        }
        error.hidden = true;
        input.setAttribute('aria-invalid', 'false');
        status.textContent = `hello, ${value}!`;
        status.hidden = false;
        input.value = '';
      });
    </script>
  </body>
</html>
