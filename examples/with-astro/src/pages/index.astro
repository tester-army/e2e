---
import '@fontsource/stack-sans-notch/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/dm-mono/400.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>e2e - with-astro</title>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <img src="/e2e-lockup-32-white.svg" alt="e2e" width="109" height="32" />
      </header>

      <main class="hero">
        <p class="eyebrow">[01] with-astro</p>
        <h1 class="title">Say hello</h1>
        <p class="lede">A demo screen for the e2e examples. Type a name and the app greets you.</p>

        <form class="form" id="greeting">
          <label class="label" for="name">Name</label>
          <div class="row">
            <input id="name" class="field" autocomplete="off" placeholder="Ada Lovelace" />
            <button class="button" type="submit">Greet</button>
          </div>
          <p class="error" role="alert" id="error" hidden>Enter a name first.</p>
          <p class="status" role="status" id="status" hidden></p>
        </form>
      </main>

      <footer class="footer">Example app for e2e. The tests live in tests/.</footer>
    </div>

    <script>
      const form = document.querySelector<HTMLFormElement>('#greeting')!;
      const input = document.querySelector<HTMLInputElement>('#name')!;
      const error = document.querySelector<HTMLParagraphElement>('#error')!;
      const status = document.querySelector<HTMLParagraphElement>('#status')!;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const value = input.value.trim();
        if (value === '') {
          error.hidden = false;
          status.hidden = true;
          return;
        }
        error.hidden = true;
        status.textContent = `Hello, ${value}!`;
        status.hidden = false;
        input.value = '';
      });
    </script>
  </body>
</html>
