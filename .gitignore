node_modules/
dist/
.env.local
*.tsbuildinfo
.e2e/artifacts/
# Committing cache entries is opt-in: `e2e init` ignores `.e2e/cache/` and a
# project removes that line to share replays. The two benchmarks commit theirs
# so their agentic suites replay in CI; the testbed ignores its own.
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
packages/e2e/tests/tmp-projects/
# The e2e package ships the repository skill (skills/e2e); the build copies it here.
packages/e2e/skills/
.vercel
.env*
# `pnpm run canary` writes this changeset and consumes it in the same run.
.changeset/canary.md
