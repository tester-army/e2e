node_modules/
dist/
*.tsbuildinfo
.e2e/artifacts/
# Cache entries are committable in a user's project, and `e2e init` leaves them
# tracked on purpose. They are ignored here because this repo's only caches come
# from the testbed: throwaway fixture apps and a live production site, so no entry
# is ever worth committing.
.e2e/cache/
.e2e/sessions/
.e2e/report.json
.e2e/report.html
.e2e/ai-trace.json
packages/e2e/tests/tmp-projects/
# The e2e package ships the repository skill (skills/e2e); the build copies it here.
packages/e2e/skills/
