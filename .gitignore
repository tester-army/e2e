dist/
.env.local
*.tsbuildinfo
.e2e/artifacts/
# Committing cache entries is opt-in: `e2e init` ignores `.e2e/cache/` and a
# project removes that line to share replays. This repo's only caches come from
# the testbed and the web benchmark (throwaway fixture apps and a live production
# site), so no entry is worth committing here.
.e2e/cache/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
packages/e2e/tests/tmp-projects/
# The e2e package ships the repository skill (skills/e2e); the build copies it here.
packages/e2e/skills/
.vercel
.env*
