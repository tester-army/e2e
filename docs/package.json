{
  "name": "@e2e-dev/docs",
  "private": true,
  "description": "The e2e documentation site, built with Mintlify",
  "type": "module",
  "scripts": {
    "dev": "mint dev",
    "check": "node ../scripts/check-docs-examples.ts && node ../scripts/check-docs-package-managers.ts && mint validate && mint broken-links",
    "typecheck": "tsc --noEmit --project examples/tsconfig.json"
  },
  "devDependencies": {
    "@ai-sdk/typesafe-ai": "3.0.12",
    "@e2e-dev/decision": "workspace:*",
    "@e2e-dev/mobile": "workspace:*",
    "@e2e-dev/web": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@types/node": "26.6.2",
    "agent-device": "0.21.21",
    "ai": "7.0.107",
    "e2e": "workspace:*",
    "mint": "4.2.909",
    "typescript": "7.0.2",
    "zod": "4.6.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
