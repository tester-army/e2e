---
// Replaces Starlight's PageTitle so the page description renders as a subtitle
// under the heading, the way the Fern site showed it.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<header class="page-title">
  <h1 id="_top">{title}</h1>
  {description && <p class="subtitle">{description}</p>}
</header>

<style>
  .page-title {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--ta-orange-300);
  }
  h1 {
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .subtitle {
    margin-top: 0.75rem;
    font-size: var(--sl-text-lg);
    line-height: var(--sl-line-height);
    color: var(--sl-color-gray-3);
  }
</style>
