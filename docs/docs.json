{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "e2e",
  "description": "An open framework for agentic end-to-end testing.",
  "colors": {
    "primary": "#171717",
    "light": "#fafafa",
    "dark": "#171717"
  },
  "logo": {
    "light": "/logo-black.png",
    "dark": "/logo-white.png"
  },
  "favicon": {
    "light": "/favicon-black.png",
    "dark": "/favicon-white.png"
  },
  "seo": {
    "metatags": {
      "og:image": "https://e2e.tester.army/docs/images/og.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://e2e.tester.army/docs/images/og.png"
    }
  },
  "integrations": {
    "posthog": {
      "apiKey": "phc_rT8hpREuSj5bRGPHP6KLKNuf4kfwhP4FEf6ahHHV2ZgH",
      "apiHost": "https://eu.i.posthog.com",
      "sessionRecording": false
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      {
        "title": "Open in Codex",
        "description": "Ask Codex about this page",
        "icon": "/images/contextual/codex.svg",
        "href": {
          "base": "codex://new",
          "query": [
            {
              "key": "prompt",
              "value": "Read this documentation page, so I can ask questions about it:\n\nhttps://e2e.tester.army/docs$path.md"
            }
          ]
        }
      },
      "claude",
      {
        "title": "Open in Claude Code",
        "description": "Ask Claude Code about this page",
        "icon": "/images/contextual/claude-code.svg",
        "href": {
          "base": "claude-cli://open",
          "query": [
            {
              "key": "q",
              "value": "Read this documentation page, so I can ask questions about it:\n\nhttps://e2e.tester.army/docs$path.md"
            }
          ]
        }
      },
      {
        "title": "Open in Cursor",
        "description": "Ask Cursor about this page",
        "icon": "/images/contextual/cursor.svg",
        "href": {
          "base": "https://cursor.com/link/prompt",
          "query": [
            {
              "key": "text",
              "value": "Read this documentation page, so I can ask questions about it:\n\nhttps://e2e.tester.army/docs$path.md"
            }
          ]
        }
      }
    ]
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    },
    "eyebrows": "breadcrumbs"
  },
  "navbar": {
