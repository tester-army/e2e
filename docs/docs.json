{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "e2e",
  "description": "An open framework for agentic end-to-end testing.",
  "colors": {
    "primary": "#ff8001",
    "light": "#ffb56c",
    "dark": "#b55b01"
  },
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png",
    "href": "/"
  },
  "favicon": "/favicon.ico",
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    },
    "eyebrows": "breadcrumbs"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/tester-army/e2e"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "writing-tests"
            ]
          },
          {
            "group": "Web",
            "icon": "globe",
            "pages": [
              "starting-your-app",
              "browser",
              "viewports"
            ]
          },
          {
            "group": "Mobile",
            "icon": "mobile-screen",
            "pages": [
              "mobile"
            ]
          },
          {
            "group": "Migrate",
            "icon": "arrow-right-arrow-left",
            "pages": [
              "migrate/playwright",
              "migrate/cypress",
              "migrate/selenium",
              "migrate/detox",
              "migrate/maestro"
            ]
          },
          {
            "group": "Guides",
            "icon": "compass",
            "pages": [
              "models",
              "subscriptions",
              "authentication",
              "security",
              "agents",
              "cache",
              "debugging",
              "explore",
              "ci",
              "github",
              "coding-agents"
            ]
          },
          {
            "group": "Extend",
            "icon": "puzzle-piece",
            "pages": [
              "agent-steps",
              "tools",
              "executors",
              "writing-an-engine"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Test API",
            "icon": "flask",
            "pages": [
              "reference/test",
              "reference/expect",
              "reference/screen",
              "reference/app",
              "reference/agent"
            ]
          },
          {
            "group": "Project",
            "icon": "folder-gear",
            "pages": [
              "reference/config",
              "reference/cli",
              "reference/mcp",
              "reference/reporters",
              "reference/environment",
              "reference/errors",
              "telemetry"
            ]
          },
          {
            "group": "Web",
            "icon": "globe",
            "pages": [
              "reference/playwright"
            ]
          },
          {
            "group": "Mobile",
            "icon": "mobile-screen",
            "pages": [
              "reference/agent-device"
            ]
          },
          {
            "group": "Engine contract",
            "icon": "gear",
            "pages": [
              "reference/engine"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/tester-army/e2e"
    }
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/web",
      "destination": "/browser"
    },
    {
      "source": "/reference/device",
      "destination": "/reference/agent-device"
    },
    {
      "source": "/running-tests",
      "destination": "/reference/cli"
    },
    {
      "source": "/configuration",
      "destination": "/reference/config"
    },
    {
      "source": "/from-playwright",
      "destination": "/migrate/playwright"
    },
    {
      "source": "/troubleshooting",
      "destination": "/debugging"
    },
    {
      "source": "/writing-a-driver",
      "destination": "/writing-an-engine"
    },
    {
      "source": "/writing-a-backend",
      "destination": "/writing-an-engine"
    },
    {
      "source": "/reference/backend",
      "destination": "/reference/engine"
    },
    {
      "source": "/reference/app-web",
      "destination": "/reference/playwright"
    }
  ]
}
