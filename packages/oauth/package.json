{
  "name": "@e2edev/oauth",
  "version": "0.0.0",
  "description": "Sign in to a personal ChatGPT, GitHub Copilot, or SuperGrok subscription and use it as an AI SDK model",
  "keywords": [
    "e2e",
    "ai-sdk",
    "oauth",
    "chatgpt",
    "codex",
    "github-copilot",
    "grok",
    "subscription"
  ],
  "license": "MIT",
  "contributors": [
    "Oskar Kwa\u015bniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/oauth"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/oauth#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "bin": {
    "e2e-oauth": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chatgpt": {
      "types": "./dist/chatgpt.d.ts",
      "default": "./dist/chatgpt.js"
    },
    "./copilot": {
      "types": "./dist/copilot.d.ts",
      "default": "./dist/copilot.js"
    },
    "./grok": {
      "types": "./dist/grok.d.ts",
      "default": "./dist/grok.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.17",
    "@clack/prompts": "1.8.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/xai": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.69",
    "@ai-sdk/openai-compatible": "3.0.51",
    "@ai-sdk/xai": "5.0.2",
    "@types/node": "26.4.1",
    "ai": "7.0.105",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "zod": "4.6.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
