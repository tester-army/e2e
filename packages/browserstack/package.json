{
  "name": "@e2e-dev/browserstack",
  "version": "0.1.0",
  "description": "BrowserStack App Automate real Android and iOS devices for e2e mobile tests",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "mobile-testing",
    "browserstack",
    "app-automate",
    "device-cloud",
    "real-devices",
    "agent-device",
    "ci"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/browserstack"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/browserstack#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/mobile": ">=0.12.5 <1",
    "e2e": ">=0.15.0 <1"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "workspace:*",
    "@types/node": "26.6.5",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
