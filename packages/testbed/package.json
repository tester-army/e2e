{
  "name": "@e2edev/testbed",
  "version": "0.0.0",
  "private": true,
  "description": "Dogfood suite: runs the e2e runner against a local playground app and real websites",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node node_modules/@e2edev/e2e/dist/cli/bin.js run",
    "test:headed": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --headed",
    "test:public": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.public.config.ts",
    "test:tester-army": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.tester-army.config.ts",
    "app": "node app/server.mjs",
    "test:agent": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.agent.config.ts",
    "test:dogfood": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.dogfood.config.ts",
    "test:selenium": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.selenium.config.ts",
    "bench:build": "next build bench",
    "bench:serve": "next start bench -p 4273",
    "test:bench": "pnpm run bench:build && node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.bench.config.ts",
    "test:device": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.device.config.ts",
    "demo:host": "pnpm run bench:build && node host-demo.mjs",
    "test:reminders": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.reminders.config.ts",
    "test:stress": "node node_modules/@e2edev/e2e/dist/cli/bin.js run --config e2e.stress.config.ts",
    "test:device:cached": "pnpm run test:device && pnpm run test:device && node scripts/assert-cache-replay.mjs"
  },
  "dependencies": {
    "@e2edev/agent-device": "workspace:*",
    "@e2edev/playwright": "workspace:*",
    "@e2edev/e2e": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "1.0.15",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "ai": "7.0.37",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  }
}
