{
  "name": "@e2edev/testbed",
  "version": "0.0.0",
  "private": true,
  "description": "Dogfood suite: runs the e2e runner against a local playground app and real websites",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node node_modules/e2e/dist/cli/bin.js run",
    "test:headed": "node node_modules/e2e/dist/cli/bin.js run --headed",
    "test:public": "node node_modules/e2e/dist/cli/bin.js run --config e2e.public.config.ts",
    "app": "node app/server.mjs",
    "test:agent": "node node_modules/e2e/dist/cli/bin.js run --config e2e.agent.config.ts",
    "test:dogfood": "node node_modules/e2e/dist/cli/bin.js run --config e2e.dogfood.config.ts",
    "test:selenium": "node node_modules/e2e/dist/cli/bin.js run --config e2e.selenium.config.ts"
  },
  "dependencies": {
    "@e2edev/playwright": "workspace:*",
    "e2e": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "ai": "7.0.37",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
