{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true
  },
  "include": [
    "e2e.bench.config.ts",
    "e2e.config.ts",
    "e2e.device.config.ts",
    "e2e.handoff.config.ts",
    "e2e.hostile.config.ts",
    "e2e.hostile-cache.config.ts",
    "e2e.long.config.ts",
    "e2e.long-cache.config.ts",
    "e2e.long-jitter.config.ts",
    "e2e.public.config.ts",
    "e2e.selenium.config.ts",
    "e2e.tester-army.config.ts",
    "fixtures/**/*.ts",
    "tests-bench/**/*.ts",
    "tests-bench-long/**/*.ts",
    "tests-device/**/*.ts",
    "tests-public/**/*.ts",
    "tests-selenium/**/*.ts",
    "tests-tester-army/**/*.ts",
    "tests/**/*.ts"
