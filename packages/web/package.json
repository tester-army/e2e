{
  "name": "@e2e-dev/web",
  "version": "0.15.5",
  "description": "Web engine for e2e agentic end-to-end testing: Chromium and Firefox over WebDriver BiDi",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "web-testing",
    "browser-testing",
    "browser-automation",
    "webdriver-bidi",
    "chromium",
    "firefox"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/web#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "e2e-web": "./dist/bin.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "chromium-bidi": "159.0.8135-0",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "e2e": ">=0.23.1 <1"
  },
  "devDependencies": {
    "@napi-rs/image": "1.16.0",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "devtools-protocol": "0.0.1734725",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "webdriver-bidi-protocol": "1.0.2"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
