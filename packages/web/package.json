{
  "name": "@e2e-dev/web",
  "version": "0.11.0",
  "description": "Web engine for e2e agentic end-to-end testing, built on Playwright",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "web-testing",
    "browser-testing",
    "browser-automation",
    "playwright",
    "chromium"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/web#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "e2e": ">=0.15.0 <1",
    "playwright": ">=1.63.0 <2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "e2e": "workspace:*",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
