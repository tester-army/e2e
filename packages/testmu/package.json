{
  "name": "@e2e-dev/testmu",
  "version": "0.0.3",
  "description": "TestMu AI (formerly LambdaTest) for e2e: hosted Android emulators, iOS simulators, and real devices for mobile tests, and hosted Chrome and Edge for web tests",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "mobile-testing",
    "testmu",
    "lambdatest",
    "device-cloud",
    "real-devices",
    "ios-simulator",
    "android-emulator",
    "agent-device",
    "cloud-browsers",
    "hosted-browsers",
    "chrome",
    "cdp",
    "ci"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Aman Kansal (https://github.com/amankansal-lt)",
    "Sahil Saw (https://github.com/SahilSawLT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/testmu"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/testmu#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/mobile": ">=0.12.5 <1",
    "@e2e-dev/web": ">=0.11.0 <1",
    "e2e": ">=0.15.0 <1"
  },
  "peerDependenciesMeta": {
    "@e2e-dev/mobile": {
      "optional": true
    },
    "@e2e-dev/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@e2e-dev/mobile": "workspace:*",
    "@e2e-dev/web": "workspace:*",
    "@types/node": "26.6.5",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "dependencies": {
    "@agent-device/testmu": "0.21.35"
  }
}
