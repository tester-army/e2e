{
  "name": "@e2e-dev/decision",
  "version": "0.0.0",
  "description": "Decision-model executors for e2e",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/decision"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.17",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "e2e": ">=0.15.2 <1"
  },
  "devDependencies": {
    "@e2e-dev/web": "workspace:*",
    "@types/node": "26.6.2",
    "ai": "7.0.107",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
