{
  "name": "@e2e-dev/lightpanda",
  "version": "0.0.0",
  "description": "Lightpanda browsers for e2e: run web targets in the open-source headless browser, started and stopped per run",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "lightpanda",
    "headless-browser",
    "browser-automation",
    "cdp"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/lightpanda"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/lightpanda#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/web": ">=0.11.0 <1",
    "e2e": ">=0.15.0 <1"
  },
  "devDependencies": {
    "@e2e-dev/web": "workspace:*",
    "@types/node": "26.6.2",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
