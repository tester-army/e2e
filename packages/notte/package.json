{
  "name": "@e2e-dev/notte",
  "version": "0.0.0",
  "description": "Notte cloud browsers for e2e: run web targets in Notte's hosted browser sessions",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "notte",
    "cloud-browsers",
    "hosted-browsers",
    "browser-automation",
    "chromium"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Andrea Pinto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2e-inc/e2e.git",
    "directory": "packages/notte"
  },
  "bugs": {
    "url": "https://github.com/e2e-inc/e2e/issues"
  },
  "homepage": "https://github.com/e2e-inc/e2e/tree/main/packages/notte#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/web": ">=0.11.0 <1",
    "notte-sdk": ">=1.10.0 <2",
    "e2e": ">=0.15.0 <1"
  },
  "devDependencies": {
    "@e2e-dev/web": "workspace:*",
    "@types/node": "26.6.6",
    "e2e": "workspace:*",
    "notte-sdk": "1.10.9",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
