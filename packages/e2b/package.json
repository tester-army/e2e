{
  "name": "@e2e-dev/e2b",
  "version": "0.0.0",
  "description": "E2B sandboxes for e2e: Android on the android-16 template for mobile tests, and Chromium for web tests",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "mobile-testing",
    "e2b",
    "sandbox",
    "android-emulator",
    "agent-device",
    "cloud-browsers",
    "hosted-browsers",
    "chromium",
    "cdp",
    "ci"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Tomas Varga <tomasvarga@sudolabs.io>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2e-inc/e2e.git",
    "directory": "packages/e2b"
  },
  "bugs": {
    "url": "https://github.com/e2e-inc/e2e/issues"
  },
  "homepage": "https://github.com/e2e-inc/e2e/tree/main/packages/e2b#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/mobile": ">=0.12.6 <1",
    "@e2e-dev/web": ">=0.11.0 <1",
    "e2b": ">=2.62.0 <3",
    "e2e": ">=0.15.0 <1"
  },
  "peerDependenciesMeta": {
    "@e2e-dev/mobile": {
      "optional": true
    },
    "@e2e-dev/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@e2e-dev/mobile": "workspace:*",
    "@e2e-dev/web": "workspace:*",
    "@types/node": "26.6.6",
    "e2b": "2.63.0",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "dependencies": {
    "agent-device": "0.21.36"
  }
}
