{
  "name": "@e2e-dev/integrations",
  "version": "0.0.0",
  "description": "Official integrations for e2e: hosted browsers and devices behind the engines' provider seams",
  "keywords": [
    "e2e",
    "testing",
    "agentic",
    "end-to-end",
    "integrations",
    "kernel",
    "hosted-browsers"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/integrations"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/integrations#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/web": ">=0.11.0 <1",
    "@onkernel/sdk": ">=0.113.0 <1"
  },
  "peerDependenciesMeta": {
    "@e2e-dev/web": {
      "optional": true
    },
    "@onkernel/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@e2e-dev/web": "workspace:*",
    "@onkernel/sdk": "0.113.0",
    "@types/node": "26.6.2",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
