{
  "name": "@e2edev/playwright",
  "version": "0.10.0",
  "description": "Playwright browser engine for e2e agentic end-to-end testing",
  "keywords": [
    "e2e",
    "testing",
    "agentic",
    "end-to-end",
    "playwright",
    "engine"
  ],
  "license": "MIT",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/playwright"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/playwright#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "e2e": ">=0.8.0 <1",
    "playwright": ">=1.63.0 <2"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "e2e": "workspace:*",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
