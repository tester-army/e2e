{
  "name": "@e2edev/agent-device",
  "version": "0.5.0",
  "description": "agent-device mobile engine (iOS and Android) for e2e agentic end-to-end testing",
  "keywords": [
    "e2e",
    "testing",
    "agentic",
    "end-to-end",
    "agent-device",
    "ios",
    "android",
    "engine"
  ],
  "license": "MIT",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/agent-device"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/agent-device#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "restricted",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:simulator": "E2E_AGENT_DEVICE_SIMULATOR=1 vitest run tests/integration"
  },
  "dependencies": {
    "agent-device": "0.20.10",
    "pngjs": "7.0.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "@e2edev/e2e": ">=0.9.0 <1"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
    "ai": "7.0.93",
    "@e2edev/e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
