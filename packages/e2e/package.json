{
  "name": "e2e",
  "version": "0.15.0-canary-20260925150007",
  "description": "SDK, runner, and CLI for agentic end-to-end testing",
  "keywords": [
    "e2e",
    "testing",
    "agentic",
    "end-to-end",
    "chatgpt",
    "github-copilot",
    "grok",
    "subscription"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/e2e"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/public.d.ts",
      "default": "./dist/agent/public.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./oauth/chatgpt": {
      "types": "./dist/oauth/chatgpt.d.ts",
      "default": "./dist/oauth/chatgpt.js"
    },
    "./oauth/copilot": {
      "types": "./dist/oauth/copilot.d.ts",
      "default": "./dist/oauth/copilot.js"
    },
    "./oauth/grok": {
      "types": "./dist/oauth/grok.d.ts",
      "default": "./dist/oauth/grok.js"
    }
  },
  "bin": {
    "e2e": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "schema/*.schema.json",
    "skills",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');for(const dir of ['dist','skills'])fs.rmSync(dir,{recursive:true,force:true});fs.cpSync('../../skills/e2e','skills/e2e',{recursive:true})\" && tsc --project tsconfig.build.json && node -e \"const fs=require('node:fs');const read=(dir)=>JSON.parse(fs.readFileSync('../'+dir+'/package.json','utf8'));const versions=Object.fromEntries(['web','mobile'].map((dir)=>['@e2e-dev/'+dir,read(dir).version]));versions.playwright=read('web').devDependencies.playwright;fs.writeFileSync('dist/cli/init/sibling-versions.json',JSON.stringify(versions)+'\\n')\" && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.18",
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@vitest/expect": "5.0.2",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.14",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/xai": "^5.0.0",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.71",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@ai-sdk/xai": "5.0.4",
    "@e2e-dev/web": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@types/node": "26.6.2",
    "@types/pngjs": "6.0.5",
    "ai": "7.0.107",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
