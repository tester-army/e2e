{
  "name": "@e2edev/e2e",
  "version": "0.6.0",
  "description": "SDK, runner, and CLI for agentic end-to-end testing",
  "keywords": [
    "e2e",
    "testing",
    "agentic",
    "end-to-end"
  ],
  "license": "MIT",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/e2e"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "restricted",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/public.d.ts",
      "default": "./dist/agent/public.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./run": {
      "types": "./dist/run/public.d.ts",
      "default": "./dist/run/public.js"
    }
  },
  "bin": {
    "e2e": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');for(const dir of ['dist','skills'])fs.rmSync(dir,{recursive:true,force:true});fs.cpSync('../../skills/e2e','skills/e2e',{recursive:true})\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@vitest/expect": "4.1.10",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "7.0.37",
    "@e2edev/playwright": "workspace:*",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
