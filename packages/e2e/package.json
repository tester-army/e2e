{
  "name": "e2e",
  "version": "0.1.0",
  "description": "Reference runner for the e2e agentic end-to-end testing standard",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./driver": {
      "types": "./dist/driver/index.d.ts",
      "default": "./dist/driver/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    }
  },
  "bin": {
    "e2e": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && pnpm run check:driver-drift",
    "check:driver-drift": "tsc --project tsconfig.driver-drift.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@vitest/expect": "4.1.10",
    "ai": "7.0.37",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@e2edev/playwright": "workspace:*",
    "@types/json-schema": "7.0.15",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
