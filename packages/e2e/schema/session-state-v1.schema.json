{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2e.dev/schema/session-state-v1.schema.json",
  "title": "e2e session-state-1",
  "description": "What an e2e-core SessionState's export() writes: the engine, platform, and app it restores on, in the clear and authenticated, and the captured state with the secret values the session had learned, AES-256-GCM encrypted under a key the caller holds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engine", "platform", "appIdentity", "createdAt", "secrecy", "state"],
  "properties": {
    "schemaVersion": { "const": "session-state-1" },
    "engine": { "type": "string", "minLength": 1, "maxLength": 256 },
    "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
    "appIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "secrecy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names"],
      "properties": {
        "names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "algorithm", "iv", "tag", "ciphertext"],
      "properties": {
        "format": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 },
        "algorithm": { "const": "A256GCM" },
        "iv": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" },
        "ciphertext": {
          "allOf": [
            { "$ref": "#/$defs/base64" },
            { "type": "string", "minLength": 4, "maxLength": 89478488 }
          ]
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
