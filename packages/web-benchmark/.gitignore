app/.next/
# Next rewrites this on every dev and build, pointing at whichever output
# directory ran last; the app's tsconfig includes it once generated.
app/next-env.d.ts
.e2e/artifacts/
# `.e2e/cache/` is committed: the agentic suite replays it in CI and calls the
# model only for a step with no recording. Re-record with `test:agent` and
# commit the entries in the same pull request as the scenario change.
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
